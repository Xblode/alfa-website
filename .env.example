# Valeurs fictives, à remplacer dans .env.local (non versionné).
# Aucune de ces valeurs n'est un secret réel.

# Navigateur : clé publique uniquement.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key

# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key
SUPABASE_PROJECT_ID=example-project-ref
SUPABASE_ACCESS_TOKEN=example-supabase-access-token
SUPABASE_DB_PASSWORD=example-db-password

# ClickUp. L'accès du kit passe par le MCP ClickUp (OAuth), pas par un jeton dans le dépôt.
# Destination : espace Projets, dossier au nom du projet, listes par métier.
# Voir docs/06-delivery/CLICKUP_CONVENTION.md.

# Ces trois valeurs sont des secrets GitHub Actions, pas des variables du navigateur :
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
